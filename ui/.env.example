# Valori backend address (server-side only — not exposed to browser)
# VALORI_API_URL=http://localhost:3000  # commented out — let ui-connections.json manage the active URL

# Bearer token (leave blank if VALORI_AUTH_TOKEN is not set on the backend)
# VALORI_AUTH_TOKEN=

# Set to "true" to show the Cluster Health tab in the sidebar
NEXT_PUBLIC_CLUSTER_MODE=false

# --- Cloud mode (lib/server/api-client.ts) ---
# Local mode (default) needs none of this — it talks straight to whatever
# node ui-connections.json points at, unchanged from before these existed.

# Set by the valori-ui website deployment ONLY — forces cloud mode always,
# ignoring the desktop app's ~/.valori/ui-mode.json toggle. Leave unset here.
# VALORI_FORCE_CLOUD=1

# Where cloud-mode requests go (the Rust control plane), and the Supabase
# project auth is checked against. Only read when in cloud mode.
# VALORI_CLOUD_API_URL=https://api.valori.systems
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
