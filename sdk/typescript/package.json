{
  "name": "@valori/sdk",
  "version": "0.1.0",
  "description": "Official TypeScript SDK for the Valori Data Plane REST API \u2014 deterministic vector + knowledge-graph store with BLAKE3-verifiable receipts.",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE-MIT",
    "LICENSE-APACHE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "generate": "./scripts/generate.sh",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepack": "npm run build"
  },
  "keywords": [
    "valori",
    "vector-database",
    "knowledge-graph",
    "rag",
    "graphrag",
    "audit-trail",
    "blake3",
    "sdk",
    "typescript"
  ],
  "author": "Varshith Gudur",
  "license": "MIT OR Apache-2.0",
  "devDependencies": {
    "@types/node": "^22.20.1",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/varshith-Git/Valori.git",
    "directory": "sdk/typescript"
  },
  "homepage": "https://github.com/varshith-Git/Valori/tree/main/sdk/typescript",
  "bugs": {
    "url": "https://github.com/varshith-Git/Valori/issues"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "valori": {
    "apiContractVersion": "1.0",
    "openapiVersion": "3.1.0",
    "contract": "api/openapi/valori-v1.yaml",
    "operations": 74
  }
}
