# Local Cloud E2E environment — copy to .env and edit if you want
# non-default values. Every default here is a throwaway local secret,
# never used anywhere real. Do NOT put a real Supabase/production secret
# in this file.

POSTGRES_PASSWORD=postgres

# HS256 secret this environment's own PostgREST instance verifies JWTs
# against (see scripts/sign_jwt.js, ui/entrypoint.e2e.js). Not a
# production Supabase JWT secret — this environment never talks to a real
# Supabase project.
JWT_SECRET=local-e2e-jwt-secret-do-not-use-in-prod-32ch

# A real HS256 JWT {role: "anon"}, signed with JWT_SECRET above — needed
# as a Docker build ARG for ui/ (NEXT_PUBLIC_* vars are inlined at build
# time, not read at container runtime). Long-lived (~10 years) since this
# whole environment is disposable. Precomputed via:
#   node scripts/sign_jwt.js anon "" local-e2e-jwt-secret-do-not-use-in-prod-32ch 315360000
# Regenerate this if you change JWT_SECRET from its default above.
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJyb2xlIjoiYW5vbiIsImV4cCI6MjEwMTc0ODIyM30.BKTIME6rEenKG90LX-L2N6E8FRTP4LFqbaB52V3Vpjk

# Per-worker internal credentials (VALORI_AUTH_TOKEN) — analogous to what
# the real Rust provisioner generates per-project in production
# (projects.worker_auth_token). Fixed here since this environment seeds
# project<->worker mapping directly rather than through the provisioner.
WORKER_A_TOKEN=worker-a-secret
WORKER_B_TOKEN=worker-b-secret

# Absolute paths to the two repos this compose file builds from. Defaults
# assume the conventional sibling-directory layout
# (.../sass/Valori-Kernel, .../sass/valori-ui). Override if yours differs.
# VALORI_KERNEL_PATH=../..
# VALORI_UI_PATH=../../../valori-ui
